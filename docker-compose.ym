version: "3.9"

services:
  api:
    build: .
    ports:
      - "8000:8000"
    env_file:
      - .env
    volumes:
      - .chroma:/app/.chroma
      - ./data:/app/data
    command: python api_server.py
    restart: unless-stopped

  ui:
    build: .
    ports:
      - "8501:8501"
    env_file:
      - .env
    volumes:
      - .chroma:/app/.chroma
      - ./data:/app/data
    command: python -m streamlit run app.py --server.port 8501 --server.address 0.0.0.0
    depends_on:
      - api
    restart: unless-stopped